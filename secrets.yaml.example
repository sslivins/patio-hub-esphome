# Copy this file to secrets.yaml and fill in real values.
# secrets.yaml is gitignored and must never be committed.

# WiFi the Core2 joins. Quote SSIDs that contain spaces or apostrophes.
wifi_ssid: "your-ssid"
wifi_password: "your-wifi-password"

# ESPHome native-API encryption key (base64, 32 bytes).
# Generate with: openssl rand -base64 32
core2_patio_api_key: "REPLACE_WITH_BASE64_32_BYTE_KEY"

# OTA password for future over-the-air updates.
core2_patio_ota_password: "choose-an-ota-password"
